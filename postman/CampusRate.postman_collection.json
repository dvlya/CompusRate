{
  "info": {
    "_postman_id": "58c6947b-a6a9-4de5-8d51-72b15385a8f8",
    "name": "CampusRate API v1",
    "description": "10 scénarios manuels pour vérifier le contrat REST CampusRate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Créer un lieu valide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cafeteria\",\n  \"description\": \"A welcoming place to enjoy delicious meals and hang out with friends.\",\n  \"category\": \"cafeteria\",\n  \"address\": \"Main pavilion\",\n  \"services\": [\"WIFI\", \"POWER_OUTLETS\", \"SEATING\", \"TAKEOUT\", \"MICROWAVE\", \"COFFEE\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/places"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('placeId', body.id);",
              "pm.test('Location est présent', () => pm.expect(pm.response.headers.get('Location')).to.include(body.id));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2 - Propriété inconnue et champs serveur refusés",
      "item": [
        {
