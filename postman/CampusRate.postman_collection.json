{
  "info": {
    "_postman_id": "58c6947b-a6a9-4de5-8d51-72b15385a8f8",
    "name": "CampusRate API v1",
    "description": "10 manual scenarios to verify the CampusRate REST contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Create a valid place",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cafeteria\",\n  \"description\": \"A welcoming place to enjoy delicious meals and hang out with friends.\",\n  \"category\": \"cafeteria\",\n  \"address\": \"Main pavilion\",\n  \"services\": [\"WIFI\", \"POWER_OUTLETS\", \"SEATING\", \"TAKEOUT\", \"MICROWAVE\", \"COFFEE\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/places"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('placeId', body.id);",
              "pm.test('Location header is present', () => pm.expect(pm.response.headers.get('Location')).to.include(body.id));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2 - Reject unknown properties and server-managed fields",
      "item": [
        {
          "name": "2 - Reject an unknown property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cafeteria\",\n  \"description\": \"Food service in the central pavilion.\",\n  \"category\": \"cafeteria\",\n  \"address\": \"Central pavilion, level 1\",\n  \"isAdministrator\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/places"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Problem Details', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); pm.expect(pm.response.json()).to.have.keys('type', 'title', 'status', 'detail', 'instance'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject a client-provided ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/places",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cafeteria\",\n  \"description\": \"Food service in the central pavilion.\",\n  \"category\": \"cafeteria\",\n  \"address\": \"Central pavilion, level 1\",\n  \"id\": \"client-id\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Problem Details', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); pm.expect(pm.response.json()).to.have.keys('type', 'title', 'status', 'detail', 'instance'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Filter and paginate places",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/places?category=cafeteria&page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Pagination', () => { const body = pm.response.json(); pm.expect(body).to.have.keys('data', 'pagination'); pm.expect(body.pagination).to.have.keys('page', 'limit', 'totalItems', 'totalPages'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4 - Get the created place",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/places/{{placeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Correct ID', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('placeId')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5 - Partially update a place",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"TEMPORARILY_CLOSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/places/{{placeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Status updated', () => pm.expect(pm.response.json().status).to.eql('TEMPORARILY_CLOSED'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6 - Create a review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorName\": \"Dalia Laifa\",\n  \"rating\": 5,\n  \"comment\": \"Delicious meals and a welcoming atmosphere.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/places/{{placeId}}/reviews"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('reviewId', body.id);",
              "pm.test('placeId matches the URI', () => pm.expect(body.placeId).to.eql(pm.collectionVariables.get('placeId')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7 - Retrieval and persistence after restart",
      "description": "After scenario 6, stop and restart the API before sending these requests. The resources must remain available with the same IDs.",
      "item": [
        {
          "name": "7 - List reviews for the place",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/places/{{placeId}}/reviews"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('At least one review', () => pm.expect(pm.response.json().length).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get the review after restart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Review persisted', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reviewId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8 - Valid updates and errors",
      "item": [
