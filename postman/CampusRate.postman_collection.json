    {
      "name": "3 - Filtrer et paginer les lieux",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/places?category=cafeteria&page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Pagination', () => { const body = pm.response.json(); pm.expect(body).to.have.keys('data', 'pagination'); pm.expect(body.pagination).to.have.keys('page', 'limit', 'totalItems', 'totalPages'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4 - Consulter le lieu créé",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/places/{{placeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Bon identifiant', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('placeId')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5 - Modifier partiellement un lieu",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"TEMPORARILY_CLOSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/places/{{placeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Statut modifié', () => pm.expect(pm.response.json().status).to.eql('TEMPORARILY_CLOSED'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6 - Créer un avis",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorName\": \"Dalia Laifa\",\n  \"rating\": 5,\n  \"comment\": \"Delicious meals and a welcoming atmosphere.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/places/{{placeId}}/reviews"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('reviewId', body.id);",
              "pm.test('Le placeId vient de l’URI', () => pm.expect(body.placeId).to.eql(pm.collectionVariables.get('placeId')));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7 - Consultation et persistance après redémarrage",
      "description": "Après le scénario 6, arrêter puis redémarrer l’API avant ces requêtes. Les identifiants doivent rester disponibles.",
      "item": [
        {
          "name": "7 - Lister les avis du lieu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/places/{{placeId}}/reviews"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Au moins un avis', () => pm.expect(pm.response.json().length).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Consulter l’avis après redémarrage",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Avis conservé', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reviewId')));"
                ]
              }
            }
          ]
        }
      ]
    },
