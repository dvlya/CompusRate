              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"A nice place to eat and hang out with friends.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}"
          },
          "event": [
            {
              "listen": "test",
