    {
      "name": "10 - Allowed deletions and statistics",
      "item": [
        {
          "name": "10 - Delete the review",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Empty response body', () => pm.expect(pm.response.text()).to.eql(''));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Check statistics with no reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/places/{{placeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statistics reset', () => { const b = pm.response.json(); pm.expect(b.reviewCount).to.eql(0); pm.expect(b.averageRating).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the place with no reviews",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/places/{{placeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "pm.test('Empty response body', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        }
      ]
